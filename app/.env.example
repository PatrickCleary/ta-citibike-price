# Stadia Maps API key (https://stadiamaps.com). Exposed client-side — lock it to
# your domain(s) in the Stadia dashboard. Omit for localhost; Stadia allows
# keyless requests from localhost during development.
PUBLIC_STADIA_API_KEY=

# Where the app fetches per-station reachability JSON from. Defaults to the
# public Supabase bucket (see src/lib/sheds.ts). Override only for local
# development against a /reach folder, or to point at a different bucket.
# PUBLIC_REACH_BASE_URL=https://kevndteqglsoslznrntz.supabase.co/storage/v1/object/public/ta-citibike-price/reachable
